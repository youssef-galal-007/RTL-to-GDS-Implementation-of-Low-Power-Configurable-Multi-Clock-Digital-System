create_generated_clock -name ALU_CLK -source [get_ports {i_Ref_Clk}] -divide_by 1 -master_clock [get_clocks {REF_CLK}] -add [get_pins {GATED_CLK/U0_TLATNCAX12M/ECK}]
create_generated_clock -name TX_CLK -source [get_ports {i_Uart_Clk}] -divide_by 32 -master_clock [get_clocks {UART_CLK}] -add [get_pins {TX_CLK_G/U7/Y}]
create_generated_clock -name RX_CLK -source [get_ports {i_Uart_Clk}] -divide_by 1 -master_clock [get_clocks {UART_CLK}] -add [get_pins {RX_CLK_G/U7/Y}]
set_propagated_clock  [get_ports {scan_clk_dft}]
